<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Privacy-first: prevent learned words and personal dictionary from cloud backup -->
        <exclude domain="sharedpref" path="rynk_user_dictionary.xml" />
        <exclude domain="file" path="adaptive_dict.bin" />
        <exclude domain="file" path="adaptive_dict.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="rynk_user_dictionary.xml" />
        <exclude domain="file" path="adaptive_dict.bin" />
        <exclude domain="file" path="adaptive_dict.json" />
    </device-transfer>
</data-extraction-rules>
