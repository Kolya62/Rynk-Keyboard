<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rynk" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/rynk_primary</item>
        <item name="colorPrimaryVariant">@color/rynk_primary_variant</item>
        <item name="colorSecondary">@color/rynk_accent</item>
        <item name="android:windowBackground">@color/rynk_bg_dark</item>
    </style>

    <style name="Theme.Rynk.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rynk_primary</item>
        <item name="colorPrimaryVariant">@color/rynk_primary_variant</item>
        <item name="colorSecondary">@color/rynk_accent</item>
        <item name="android:windowBackground">@color/rynk_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <!-- Settings screens are always dark to match the toolbar and background colors -->
    <style name="Theme.Rynk.Settings" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/rynk_primary</item>
        <item name="colorPrimaryVariant">@color/rynk_primary_variant</item>
        <item name="colorSecondary">@color/rynk_accent</item>
        <item name="colorAccent">@color/rynk_accent</item>
        <item name="android:windowBackground">@color/rynk_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
