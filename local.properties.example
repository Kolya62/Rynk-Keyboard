# Example local.properties configuration for release signing
# Copy to local.properties or set matching environment variables

# sdk.dir=/path/to/Android/Sdk
# ndk.dir=/path/to/Android/Sdk/ndk/26.3.11579264

# Release Keystore (Optional - leave unset for unsigned release build)
# rynk.release.storeFile=/path/to/release.keystore
# rynk.release.storePassword=your_keystore_password
# rynk.release.keyAlias=your_key_alias
# rynk.release.keyPassword=your_key_password
